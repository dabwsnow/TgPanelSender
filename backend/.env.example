# .env — конфигурация TGPanel
# Скопируй этот файл и переименуй в .env

# Сервер
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Telegram — ОБЯЗАТЕЛЬНО! Получи на https://my.telegram.org
# Один API_ID + API_HASH на все аккаунты
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890

# Планировщик
SPAM_CHECK_INTERVAL=30

# Дефолтные лимиты рассылки
DEFAULT_DAILY_LIMIT=50
DEFAULT_DELAY_MIN=5
DEFAULT_DELAY_MAX=15

# Безопасность: Секретный путь для админ-панели (например: /panel)
# Если оставить пустым или /, панель будет доступна по обычному адресу
ADMIN_SECRET_PATH=/panel

# Пароль для доступа в админ-панель. Если оставить пустым, авторизация будет отключена.
ADMIN_PASSWORD=adminpass123
